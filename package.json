{
  "name": "stadtverbesserungskarte-immenstadt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Stadtverbesserungskarte Immenstadt i. Allgäu – Karte mit Verbesserungsvorschlägen für die Stadt",
  "scripts": {
    "dev": "npm run items && vite",
    "build": "npm run items && npm run validate && npm run licenses && tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "items": "node scripts/build-items.mjs",
    "licenses": "node scripts/licenses.mjs",
    "validate": "node scripts/validate-data.mjs",
    "typecheck": "tsc -b --noEmit",
    "placeholders": "node scripts/make-placeholder-images.mjs",
    "a11y": "node scripts/a11y-audit.mjs",
    "interactions": "node scripts/check-map-interactions.mjs",
    "shots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "dompurify": "^3.4.14",
    "img-comparison-slider": "^8.0.7",
    "marked": "^18.0.11",
    "ol": "^10.10.0",
    "ol-mapbox-style": "^13.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.13.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.9.0",
    "vite": "^8.2.0",
    "yaml": "^2.9.0"
  }
}
