{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stadtverbesserungskarte-immenstadt.de/schema/items.schema.json",
  "title": "Verbesserungsvorschläge",
  "description": "Liste aller Einträge, die auf der Stadtverbesserungskarte angezeigt werden.",
  "type": "array",
  "items": { "$ref": "#/$defs/item" },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "location", "layers", "images", "description", "author"],
      "properties": {
        "id": {
          "description": "Eindeutige, URL-taugliche Kennung. Wird für die Detailseite (/vorschlag/<id>) und für die Bilddateinamen verwendet.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "minLength": 3,
          "maxLength": 80
        },
        "title": {
          "description": "Kurzer, sprechender Titel des Vorschlags.",
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "location": {
          "description": "Position des Vorschlags in WGS84 (EPSG:4326).",
          "type": "object",
          "additionalProperties": false,
          "required": ["lat", "lon"],
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lon": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        },
        "layers": {
          "description": "Ebenen, in denen der Eintrag erscheint. Ein Eintrag kann in mehreren Ebenen liegen.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["radverkehr", "klimafolgenanpassung"] }
        },
        "images": {
          "type": "object",
          "additionalProperties": false,
          "required": ["before", "after", "beforeAlt", "afterAlt"],
          "properties": {
            "before": {
              "description": "Pfad zum Vorher-Bild, relativ zum Ordner public/.",
              "type": "string",
              "pattern": "^images/items/[A-Za-z0-9._-]+\\.(jpg|jpeg|png|webp|avif|svg)$"
            },
            "after": {
              "description": "Pfad zum Nachher-Bild, relativ zum Ordner public/.",
              "type": "string",
              "pattern": "^images/items/[A-Za-z0-9._-]+\\.(jpg|jpeg|png|webp|avif|svg)$"
            },
            "beforeAlt": {
              "description": "Alternativtext des Vorher-Bildes. Beschreibt die heutige Situation für Menschen, die das Bild nicht sehen können.",
              "type": "string",
              "minLength": 10,
              "maxLength": 300
            },
            "afterAlt": {
              "description": "Alternativtext des Nachher-Bildes. Beschreibt die vorgeschlagene Verbesserung.",
              "type": "string",
              "minLength": 10,
              "maxLength": 300
            }
          }
        },
        "description": {
          "description": "Beschreibung des Vorschlags. Absätze werden mit einer Leerzeile getrennt.",
          "type": "string",
          "minLength": 10
        },
        "author": {
          "description": "Wer den Vorschlag eingebracht hat.",
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        }
      }
    }
  }
}
